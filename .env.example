# Private Google Sheet CRM using keyless Vercel OIDC federation.
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_spreadsheet_id
GOOGLE_WIF_AUDIENCE=//iam.googleapis.com/projects/replace_with_project_number/locations/global/workloadIdentityPools/replace_with_pool/providers/replace_with_provider
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace_with_service_account@replace_with_project.iam.gserviceaccount.com
UPG_CRM_SHEET_URL=https://docs.google.com/spreadsheets/d/replace_with_spreadsheet_id/edit

# Existing form notification settings
RESEND_API_KEY=re_replace_me
RESEND_FROM=UPG Forms <quotes@universalpackaginggroup.com>
UPG_NOTIFY_TO=umar@universalpackaginggroup.com

# Public GA4 web stream identifier (not a secret).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe hosted Checkout for the fixed-price sample kits.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Enable only after Stripe Tax is configured for the live account.
STRIPE_AUTOMATIC_TAX=false

# Server-only Stripe test-mode lane. Never expose these through NEXT_PUBLIC variables.
STRIPE_TEST_SECRET_KEY=sk_test_replace_me
STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TEST_ACCESS_TOKEN=replace_with_a_long_random_token
